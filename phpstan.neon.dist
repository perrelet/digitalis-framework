# Shared settings, level 0 over the whole tree. CI runs phpstan.ci.neon (this plus workers) and phpstan.level5.neon (this at level 5 over
# the raised directories). Locally the whole tree runs in about three minutes within 1.2 GB; a gitignored phpstan.neon overrides.
parameters:
  level: 0
  phpVersion: 80000
  tmpDir: tmp/phpstan
  paths:
    - include
    - load.php
    - bin
  scanFiles:
    - compat/digitalis-namespace.php
    - compat/digitalis-hooks.php
    - stubs/oxygen.stub.php
    - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    - vendor/php-stubs/acf-pro-stubs/acf-pro-stubs.php
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    - vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
  parallel:
    maximumNumberOfProcesses: 1
